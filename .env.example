# Copy to .env and edit. Find your league ID in the URL on
# fantasy.premierleague.com under Leagues → Your League → Standings:
#   .../leagues/<LEAGUE_ID>/standings/c
FPL_LEAGUE_ID=59720

# Current-season DB and (optional) last season's archived DB. Setting
# FPL_PREV_DB enables the "vs Last Season" section + narrative comparisons.
# FPL_DB=data/26_27_fpl.db
# FPL_PREV_DB=data/25_26_fpl.db

# Optional: enables the AI-written "Week in Words" narrative (fpl publish /
# report use it automatically when set). This file is git-ignored — keep your
# real key here, never commit it.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: `fpl reddit` grounding input. Reddit blocks unauthenticated reads,
# so create a free "script" app at https://www.reddit.com/prefs/apps and paste
# the client id + secret here. Read-only; no Reddit password needed.
# Git-ignored — never commit these.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
